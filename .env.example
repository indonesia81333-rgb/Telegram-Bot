# Telegram credentials: https://my.telegram.org and @BotFather
API_ID=123456
API_HASH=replace_with_api_hash
BOT_TOKEN=123456789:replace_with_botfather_token
ADMIN_IDS=123456789

# FileBee website
FILEBEE_WEBSITE=https://filebee.live

# IMPORTANT:
# FileBee.live's public upload API was not verifiable when this project was built.
# Leave FILEBEE_UPLOAD_URL empty for manual upload + link-saving mode.
# Only set these values when FileBee provides an official API contract.
FILEBEE_UPLOAD_URL=
FILEBEE_API_TOKEN=
FILEBEE_AUTH_HEADER=Authorization
FILEBEE_AUTH_PREFIX=Bearer 
FILEBEE_FILE_FIELD=file
# Optional JSON path, e.g. data.share_url; blank = search common URL fields
FILEBEE_RESPONSE_URL_FIELD=
FILEBEE_UPLOAD_TIMEOUT=3600

# Application limits (do not override Telegram/FileBee service limits)
MAX_FILE_GB=4

# Bot-side link-index expiry only. 0 = no expiry. This does NOT delete FileBee files.
LINK_RECORD_TTL_DAYS=0

# Render dashboard
PORT=10000
DATABASE_PATH=/var/data/bot.db
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change_this_to_a_long_random_password
BOT_NAME=FileBee Telegram Bot
LOG_LEVEL=INFO
